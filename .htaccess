# order deny,allow
# deny from all
# allow from 82.165.172.155
# allow from 188.26.197.18
# allow from 79.116.162.100

# Nunca servir logs, volcados SQL, backups ni ficheros de configuración local
<FilesMatch "(?i)(\.(log|sql|zip|bak|backup[0-9]*)|db\.local\.php|sftp\.json)$">
  Require all denied
</FilesMatch>
