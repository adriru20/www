# order deny,allow
# deny from all
# allow from 82.165.172.155
# allow from 188.26.197.18
# allow from 79.116.162.100

# Nunca servir logs, volcados SQL, backups ni ficheros de configuración local
<FilesMatch "(?i)(\.(log|sql|zip|bak|backup[0-9]*)|db\.local\.php|sftp\.json)$">
  Require all denied
</FilesMatch>

# Una sola dirección para la web: adriru.es -> www.adriru.es.
# La cookie de sesión es distinta en cada dirección: si se mezclan, el login se pide dos veces.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^adriru\.es$ [NC]
  RewriteRule ^(.*)$ https://www.adriru.es/$1 [R=301,L]
</IfModule>
